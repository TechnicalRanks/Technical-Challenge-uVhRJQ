# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in. Never commit the real .env.
# Loaded natively by `node --env-file` (Node >= 20) — there is no dotenv dep.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001

# The origin the BROWSER uses. In dev that is the Vite server, which proxies
# /api here — so the app is same-origin and no CORS middleware exists.
PUBLIC_ORIGIN=http://localhost:5190

# Integer hop count for X-Forwarded-For. 0 = no proxy, 1 = behind one nginx.
# NEVER set this to `true` without a real proxy: any client could then forge
# X-Forwarded-For and defeat every IP-based rate limit.
TRUST_PROXY=0

# --- Secrets: required in production, and must differ from this dev value ---
JWT_SECRET=dev-only-change-me-000000000000000000

# --- Session ---
SESSION_COOKIE_NAME=ctf_session
SESSION_TTL_SECONDS=28800

# --- Talent Platform ----------------------------------------------------------
# The ONLY auth and content source — no offline/local mode. It owns OTP
# delivery/verification (services/otpProvider.js) AND every question, hint,
# and flag (services/challengeService.js). Its user routes need no auth token
# for OTP, so nothing privileged lives in this file. It listens on :3000,
# which is why this app defaults to :3001.
TALENT_URL=http://localhost:3000
TALENT_TIMEOUT_MS=3000

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# Returns the OTP in the HTTP response so you can script a login.
# config.js FORCES this to false when NODE_ENV=production, whatever is set here.
OTP_DEV_ECHO=true

# --- Data --------------------------------------------------------------------
DATA_DRIVER=json
DATA_DIR=./data

# --- Gameplay ----------------------------------------------------------------
SUBMIT_LOCKOUT_ATTEMPTS=5
SUBMIT_LOCKOUT_SECONDS=60
ALLOW_REVISIT_SKIPPED=false
HINTS_SEQUENTIAL=true

# The whole-CTF countdown, tracked locally from first login.
ENABLE_SESSION_TIMER=true
SESSION_TIMER_SECONDS=3600
# The old app let players buy extra time with points. Its bonus lived in
# localStorage and was re-applied client-side, so it was trivially forged.
# Off unless it is reimplemented as a server-tracked debit.
ENABLE_TIME_PURCHASE=false

# --- Ops ---------------------------------------------------------------------
LOG_LEVEL=info
CLIENT_DIST_DIR=../frontend/dist
